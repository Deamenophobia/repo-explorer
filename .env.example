# Run from the project root. Demo requires no credentials or network calls.
REPO_EXPLORER_MODE=demo
# Optional local Codex generation: use chat_provider=codex and an accessible model.
# REPO_EXPLORER_CODEX_EXECUTABLE=C:/path/to/native/codex.exe
# REPO_EXPLORER_CODEX_REASONING_EFFORT=medium
# Optional server-only proxy for the Codex child process; use your own proxy port.
# REPO_EXPLORER_CODEX_PROXY_URL=http://127.0.0.1:PORT
# If unset, the CLI inherits the server's normal HTTP(S)_PROXY / NO_PROXY environment.
REPO_EXPLORER_CORPUS_DIR=examples/repository
REPO_EXPLORER_DATA_DIR=.repo-explorer
REPO_EXPLORER_CONFIG_FILE=repo-explorer.json
# Optional browser origins for a custom frontend calling the API directly; restart to apply.
# Omit when using the bundled Vite proxy. Origins have no path or trailing slash.
# REPO_EXPLORER_CORS_ORIGINS=["http://127.0.0.1:3000"]
# Saved JSON settings override environment defaults. Use the Settings screen to edit them.
# Live generation: set mode to live and choose a model available to your provider.
# REPO_EXPLORER_MODEL=your-model-id
# REPO_EXPLORER_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# REPO_EXPLORER_BASE_URL=https://api.openai.com/v1
# Optional semantic retrieval. Otherwise the explicit TF-IDF baseline is used.
# REPO_EXPLORER_EMBEDDING_PROVIDER=openai
# REPO_EXPLORER_EMBEDDING_MODEL=your-embedding-model-id
# REPO_EXPLORER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# REPO_EXPLORER_CHAT_API_KEY_ENV=OPENAI_API_KEY
# REPO_EXPLORER_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# Optional local learned embeddings: install the fastembed extra, then choose
# embedding_provider=fastembed and a supported embedding_model in live mode.
# First use downloads model files; passage/query embedding runs on this machine.
# REPO_EXPLORER_FASTEMBED_CACHE_DIR=.repo-explorer/models
# REPO_EXPLORER_FASTEMBED_THREADS=2
# After downloading the selected model, disable subsequent download attempts:
# REPO_EXPLORER_FASTEMBED_LOCAL_FILES_ONLY=true
# Array environment settings use JSON, for example REPO_EXPLORER_EXTENSIONS=[".md",".py"]
# Optional TF-IDF identifier matching; the default remains standard word tokenization.
# REPO_EXPLORER_LEXICAL_TOKENIZATION=code_identifiers
# Optional one-pass context expansion (default: none).
# REPO_EXPLORER_CONTEXT_EXPANDER=line_window
# REPO_EXPLORER_CONTEXT_WINDOW_LINES=8
# REPO_EXPLORER_CONTEXT_MAX_ADDED_CHARS=4000
# Optional syntax metadata; ranking and source excerpts stay unchanged.
# REPO_EXPLORER_SOURCE_ANALYZER=python_ast
# REPO_EXPLORER_SOURCE_SYMBOL_LIMIT=8
# REPO_EXPLORER_EVIDENCE_MAP_NODE_LIMIT=40
